{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragent.local/schemas/context-selection-dataset-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "source_id", "source", "split", "group_id", "language", "question", "answerable", "task_type", "expected_facts", "forbidden_claims", "evidence_requirements", "candidates"],
  "properties": {
    "schema_version": {"const": "context-selection-dataset-v1"},
    "id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "split": {"enum": ["public_dev", "public_test", "business_dev", "business_test", "historical_regression"]},
    "group_id": {"type": "string", "minLength": 1},
    "language": {"enum": ["en", "zh"]},
    "question": {"type": "string", "minLength": 1},
    "answerable": {"type": "boolean"},
    "answer": {"type": ["string", "null"]},
    "task_type": {"type": "string", "minLength": 1},
    "level": {"type": "string"},
    "expected_facts": {"type": "array", "items": {"type": "string"}},
    "forbidden_claims": {"type": "array", "items": {"type": "string"}},
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "alternatives"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "alternatives": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["all_of"],
              "properties": {
                "all_of": {
                  "type": "array", "minItems": 1,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["candidate_id", "document_id", "location"],
                    "properties": {
                      "candidate_id": {"type": "string", "minLength": 1},
                      "document_id": {"type": "string", "minLength": 1},
                      "location": {"type": "object"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "candidates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "document_id", "version", "location", "title", "sentences", "text"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "document_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "location": {"type": "object"},
          "title": {"type": "string"},
          "sentences": {"type": "array", "items": {"type": "string"}},
          "text": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
