# 本文件只包含本地开发默认值，不放置模型 API 密钥或生产凭据。
RAGENT_POSTGRES_USER=postgres
RAGENT_POSTGRES_PASSWORD=postgres
RAGENT_REDIS_PASSWORD=123456
RAGENT_S3_ACCESS_KEY=rustfsadmin
RAGENT_S3_SECRET_KEY=rustfsadmin

# 可选：仅替换 RocketMQ 的存储卷；先停 Broker、完整复制旧数据并创建外部卷。
# 实际本机配置写入同目录 .env。未设置时仍使用原项目命名卷。
# RAGENT_ROCKETMQ_VOLUME_NAME=ragent-iron-ore-dev_rocketmq-external-data
# RAGENT_ROCKETMQ_VOLUME_EXTERNAL=true
